#!/bin/sh
set -eu

usage() {
	echo "usage: bws-project run -- $0 {bootstrap|collector} [--check-only|<ssh-target>]" >&2
	exit 2
}

fail() {
	echo "$1" >&2
	exit 1
}

validate_target() {
	case "$1" in
		''|@*|*@|*@*@*|*[!A-Za-z0-9._@:-]*) fail 'invalid SSH target' ;;
	esac
}

require_secret() {
	name=$1
	value=$2
	[ -n "$value" ] || fail "missing $name"
	newline='
'
	carriage=$(printf '\r')
	case "$value" in
		*"$newline"*|*"$carriage"*) fail "unsafe newline in $name" ;;
	esac
}

# Docker's --env-file grammar splits a non-comment record at the first `=` and
# retains every subsequent byte. Names are fixed below; CR/LF were rejected
# before this formatter so a value cannot add a record. The stream remains
# stdin-only and never becomes a local file.
docker_environment_line() {
	name=$1
	value=$2
	printf '%s=%s\n' "$name" "$value"
}

install_openobserve='sudo /bin/sh -ec '\''set -eu
install -d -m 0700 -o root -g root /etc/observability/secrets
tmp=$(mktemp /etc/observability/secrets/.openobserve.env.XXXXXX)
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT HUP INT TERM
cat > "$tmp"
chown root:root "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" /etc/observability/secrets/openobserve.env
trap - EXIT HUP INT TERM
if systemctl cat openobserve.service >/dev/null 2>&1; then
  systemctl try-restart openobserve.service
fi'\'''

install_proxy='sudo /bin/sh -ec '\''set -eu
install -d -m 0700 -o root -g root /etc/observability/secrets
tmp=$(mktemp /etc/observability/secrets/.observe-proxy.env.XXXXXX)
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT HUP INT TERM
cat > "$tmp"
chown root:root "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" /etc/observability/secrets/observe-proxy.env
trap - EXIT HUP INT TERM
if systemctl cat observe-proxy.service >/dev/null 2>&1; then
  systemctl try-restart observe-proxy.service
fi'\'''

install_collector='sudo /bin/sh -ec '\''set -eu
install -d -m 0700 -o root -g root /etc/observability/secrets
tmp=$(mktemp /etc/observability/secrets/.otel-collector.env.XXXXXX)
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT HUP INT TERM
cat > "$tmp"
chown root:root "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" /etc/observability/secrets/otel-collector.env
trap - EXIT HUP INT TERM
for unit in otel-collector.service otel-docker-agent.service; do
  if systemctl cat "$unit" >/dev/null 2>&1; then
    systemctl try-restart "$unit"
  fi
done'\'''

[ "$#" -ge 1 ] || usage
mode=$1
shift

case "$mode" in
	bootstrap)
		require_secret ZO_ROOT_USER_EMAIL "${ZO_ROOT_USER_EMAIL-}"
		require_secret ZO_ROOT_USER_PASSWORD "${ZO_ROOT_USER_PASSWORD-}"
		require_secret CLOUDFLARE_API_TOKEN "${CLOUDFLARE_API_TOKEN-}"
		require_secret HOMELAB_OTLP_TOKEN "${HOMELAB_OTLP_TOKEN-}"
		require_secret AI_OTLP_TOKEN "${AI_OTLP_TOKEN-}"
		if [ "$#" -eq 1 ] && [ "$1" = --check-only ]; then
			echo 'bootstrap secret inputs: valid'
			exit 0
		fi
		[ "$#" -eq 1 ] || usage
		target=$1
		validate_target "$target"
		{ docker_environment_line ZO_ROOT_USER_EMAIL "$ZO_ROOT_USER_EMAIL"; docker_environment_line ZO_ROOT_USER_PASSWORD "$ZO_ROOT_USER_PASSWORD"; } |
			ssh -o BatchMode=yes "$target" "$install_openobserve"
		{ docker_environment_line CLOUDFLARE_API_TOKEN "$CLOUDFLARE_API_TOKEN"; docker_environment_line HOMELAB_OTLP_TOKEN "$HOMELAB_OTLP_TOKEN"; docker_environment_line AI_OTLP_TOKEN "$AI_OTLP_TOKEN"; } |
			ssh -o BatchMode=yes "$target" "$install_proxy"
		;;
	collector)
		require_secret OPENOBSERVE_INGEST_AUTH_HEADER "${OPENOBSERVE_INGEST_AUTH_HEADER-}"
		if [ "$#" -eq 1 ] && [ "$1" = --check-only ]; then
			echo 'collector secret inputs: valid'
			exit 0
		fi
		[ "$#" -eq 1 ] || usage
		target=$1
		validate_target "$target"
		docker_environment_line OPENOBSERVE_INGEST_AUTH_HEADER "$OPENOBSERVE_INGEST_AUTH_HEADER" |
			ssh -o BatchMode=yes "$target" "$install_collector"
		;;
	*) usage ;;
esac
