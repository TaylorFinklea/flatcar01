#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: bws-project run -- $0 <ssh-target>" >&2
  exit 2
fi

: "${WATCHTOWER_HTTP_API_TOKEN:?missing WATCHTOWER_HTTP_API_TOKEN}"
: "${SCRYPTED_WEBHOOK_UPDATE_AUTHORIZATION:?missing SCRYPTED_WEBHOOK_UPDATE_AUTHORIZATION}"

target=$1
umask 077

{
  printf 'WATCHTOWER_HTTP_API_TOKEN=%s\n' "$WATCHTOWER_HTTP_API_TOKEN"
  printf 'SCRYPTED_WEBHOOK_UPDATE_AUTHORIZATION="%s"\n' "$SCRYPTED_WEBHOOK_UPDATE_AUTHORIZATION"
} | ssh -o BatchMode=yes "$target" \
  'sudo install -d -m 0700 /etc/scrypted && sudo install -m 0600 /dev/stdin /etc/scrypted/scrypted.env && sudo systemctl restart scrypted-watchtower.service scrypted.service'
