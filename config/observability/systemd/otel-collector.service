[Unit]
Description=Privacy-gated OpenTelemetry Collector
Wants=network-online.target
After=network-online.target
After=docker.service var-lib-otelcol.mount
Requires=docker.service var-lib-otelcol.mount
ConditionPathExists=/etc/observability/images.env
ConditionPathExists=/etc/observability/otel-gateway.yaml
ConditionPathExists=/etc/observability/otel-gateway-systemd.yaml
ConditionPathExists=/etc/observability/secrets/otel-collector.env

[Service]
Type=simple
EnvironmentFile=/etc/observability/images.env
TimeoutStartSec=0
TimeoutStopSec=45
UMask=0077
ExecStartPre=/usr/bin/install -d -m 0750 -o 10001 -g 10001 /var/lib/otelcol/queue
ExecStartPre=/bin/sh -ec 'test "$(/usr/bin/stat -c "%%u:%%g:%%a" /var/lib/otelcol/queue)" = "10001:10001:750"'
ExecStartPre=/bin/sh -ec 'test "$(/usr/bin/stat -c "%%u:%%g:%%a" /etc/observability/secrets/otel-collector.env)" = "0:0:600"'
ExecStartPre=-/usr/bin/docker rm --force otel-collector
ExecStart=/etc/observability/bin/run-otel-collector
ExecStop=-/usr/bin/docker stop --time 30 otel-collector
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
