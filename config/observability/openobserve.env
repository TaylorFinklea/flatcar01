ZO_DATA_DIR=/data
ZO_LOCAL_MODE=true
ZO_LOCAL_MODE_STORAGE=disk
ZO_HTTP_ADDR=127.0.0.1
ZO_HTTP_PORT=5080
ZO_GRPC_ADDR=127.0.0.1
ZO_GRPC_PORT=5081
ZO_WEB_URL=https://observe.example.com
ZO_CORS_ALLOWED_ORIGINS=https://observe.example.com
ZO_SWAGGER_ENABLED=false
ZO_COOKIE_SECURE_ONLY=true
ZO_COOKIE_SAME_SITE_LAX=true
ZO_TELEMETRY=false
O2_AI_ENABLED=false
ZO_COMPACT_DATA_RETENTION_DAYS=30
ZO_IGNORE_FILE_RETENTION_BY_STREAM=true
ZO_COMPACT_FAST_MODE=false
ZO_MEM_TABLE_MAX_SIZE=256
ZO_MAX_FILE_SIZE_IN_MEMORY=64
ZO_MAX_FILE_SIZE_ON_DISK=32
ZO_HTTP_WORKER_NUM=2
ZO_JSON_LIMIT=4194304
ZO_PAYLOAD_LIMIT=4194304
ZO_METRICS_CACHE_ENABLED=false
